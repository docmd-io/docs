{
  "title": "docmd search",
  "url": "https://docs.docmd.io/search",
  "src": ".",

  "logo": {
    "light": "assets/images/docmd-logo-dark.png",
    "dark": "assets/images/docmd-logo-light.png",
    "alt": "docmd search",
    "href": "https://docmd.io/search"
  },
  "favicon": "assets/favicon.ico",

  "theme": {
    "template": "summer"
  },

  "layout": {
    "titleSeparator": "-",
    "footer": {
      "copyright": "© 2026 docmd.io"
    }
  },

  "i18n": {
    "default": "en",
    "position": "sidebar-top",
    "locales": [
      { "id": "en", "label": "English", "dir": "ltr" },
      { "id": "zh", "label": "中文", "dir": "ltr" },
      { "id": "de", "label": "Deutsch", "dir": "ltr" },
      { "id": "es", "label": "Español", "dir": "ltr" }
    ]
  },

  "plugins": {
    "search": {
      "semantic": true,
      "showConfidence": true
    },
    "seo": {
      "defaultDescription": "Offline semantic search engine for documentation. Local vector embeddings, in-browser execution, zero telemetry.",
      "aiBots": true,
      "breadcrumbs": true,
      "organization": {
        "name": "docmd",
        "url": "https://docmd.io",
        "logo": "assets/images/docmd-logo-dark.png",
        "sameAs": [
          "https://github.com/docmd-io/docmd",
          "https://x.com/docmd_io"
        ]
      },
      "openGraph": {
        "siteName": "docmd",
        "type": "website"
      },
      "twitter": {
        "cardType": "summary_large_image"
      }
    }
  }
}